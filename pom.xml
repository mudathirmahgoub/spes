<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>GT</groupId>
    <artifactId>equitas</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- z3 is installed under the project's .venv (official release archive,
             which ships com.microsoft.z3.jar + libz3java.dylib). -->
        <z3.home>${project.basedir}/.venv/z3</z3.home>
        <z3.jar>${z3.home}/bin/com.microsoft.z3.jar</z3.jar>
        <z3.lib>${z3.home}/bin</z3.lib>
        <!-- cvc5 built from source. -->
        <cvc5.home>/Users/mahgoubyahia/cvc5/main/build/install</cvc5.home>
        <cvc5.jar>${cvc5.home}/share/java/cvc5.jar</cvc5.jar>
        <cvc5.lib>${cvc5.home}/lib</cvc5.lib>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Native libraries for the z3 and cvc5 JNI bindings. -->
                    <argLine>-Djava.library.path=${z3.lib}:${cvc5.lib} --enable-native-access=ALL-UNNAMED</argLine>
                    <environmentVariables>
                        <DYLD_LIBRARY_PATH>${z3.lib}:${cvc5.lib}</DYLD_LIBRARY_PATH>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.apache.calcite</groupId>
            <artifactId>calcite-core</artifactId>
            <version>1.19.0</version>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>2.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.8.5</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.z3</groupId>
            <artifactId>z3</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${z3.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>io.github.cvc5</groupId>
            <artifactId>cvc5</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${cvc5.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.1</version>
        </dependency>

    </dependencies>

</project>
