\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces PostgreSQL 18 \texttt  {EXPLAIN (ANALYZE, VERBOSE, BUFFERS)} for $Q_1$ (left) and $Q_2$ (right). Note \texttt  {Inner Unique} on both joins: the planner read the primary key and recorded ``at most one match on the inner side''. \emph  {That flag is the same fact the provers write as $\ensuremath  {\left \lVert S(a) \right \rVert }$} --- Postgres uses it to stop probing early, the provers use it to justify the rewrite.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:pgplans}{{1}{8}{PostgreSQL 18 \texttt {EXPLAIN (ANALYZE, VERBOSE, BUFFERS)} for $Q_1$ (left) and $Q_2$ (right). Note \texttt {Inner Unique} on both joins: the planner read the primary key and recorded ``at most one match on the inner side''. \emph {That flag is the same fact the provers write as $\sq {S(a)}$} --- Postgres uses it to stop probing early, the provers use it to justify the rewrite}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Measured. The pushdown is only $\approx $12\% faster here and its aggregate does \emph  {more} work; the win comes from the join seeing 99{,}995 rows instead of $10^6$. Whether to apply the rewrite is a cost question --- entirely separate from whether it is \emph  {correct}, which is what this document is about.}}{8}{table.caption.8}\protected@file@percent }
